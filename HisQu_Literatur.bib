@article{koenigFertigVorerstUnfertigkeit2026,
  title = {{Fertig -- vorerst. Unfertigkeit als epistemischer Wert in den digitalen Geisteswissenschaften}},
  author = {K{\"o}nig, Mareike},
  year = 2026,
  journal = {Zeitschrift f\"ur digitale Geisteswissenschaften},
