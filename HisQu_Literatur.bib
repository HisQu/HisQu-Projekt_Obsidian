@article{JannidisLargeLanguageModelsUnderstandLiteratureCaseStudiesProbingExperimentsGermanPoetry,
  title = {Do {{Large Language Models Understand Literature}}? {{Case Studies}} and {{Probing Experiments}} on {{German Poetry}}},
  author = {Jannidis, Fotis and Kleymann, Rabea and Schr{\"o}ter, Julian and Zinsmeister, Heike},
  year = 2025,
  journal = {Journal of Computational Literary Studies},
  volume = {4},
  number = {1},
  publisher = {Universit\"ats- und Landesbibliothek Darmstadt},
  issn = {2940-1348},
  doi = {10.48694/jcls.4225},
  abstract = {This paper explores the capabilities of large language models (LLMs) in understanding literary texts, specifically poetry, through a series of qualitative experiments. Probing experiments observe model behaviour on two German poems across meter, rhyme, assonance, lexis, phrases, syntax, figurative language, titles, and meaning, at three levels of interaction --- general knowledge, expert knowledge, and abstraction and transfer. Results show LLMs excel at semantic aspects but struggle with formal elements, favour established interpretations over original insights, and are relatively inflexible in shifting cultural perspectives unless explicitly prompted.},
  langid = {english}
}

