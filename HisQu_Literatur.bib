@incollection{FuesselgelehrteFeldVormoderneMoeglichkeitenundGrenzenFeldanalysenGeschichtswissenschaft,
  title = {{Das gelehrte Feld der Vormoderne. M\"oglichkeiten und Grenzen von Feldanalysen in der Geschichtswissenschaft}},
  booktitle = {{Feldanalyse als Forschungsprogramm 1: Der programmatische Kern}},
  author = {F{\"u}ssel, Marian and Tr{\"u}ter, Ingo},
  editor = {Bernhard, Stefan and {Schmidt-Wellenburg}, Christian},
  year = 2012,
  pages = {321--344},
  publisher = {VS Verlag f\"ur Sozialwissenschaften},
  address = {Wiesbaden},
  doi = {10.1007/978-3-531-94259-9_12},
  urldate = {2026-05-29},
  abstract = {Innerhalb der Soziologie Pierre Bourdieus spielt die Analyse des wissenschaftlichen Feldes eine zentrale Rolle. Sie gew\"ahrt nicht nur einen kritischen Blick auf die soziale Reproduktion und Distinktion von Gelehrten, Wissenschaftlern und Intellektuellen, sondern schafft \"uberhaupt erst die Bedingungen f\"ur eine ,,reflexive Anthropologie`` (Bourdieu / Wacquant 1996a), indem sie allgemein nach den sozialen Konstitutionsbedingungen von Wissenschaft fragt. F\"ur die interdisziplin\"are Anschlussf\"ahigkeit bietet Bourdieus praxeologische Wissenssoziologie jedoch mehrere H\"urden. Einerseits konzentrieren sich seine empirischen Untersuchungen auch im Falle der Wissenschaft meist auf die franz\"osische Gesellschaft des 20. Jahrhunderts, andererseits hat er selbst keine Versuche unternommen, die Entwicklung des wissenschaftlichen Feldes, im Gegensatz etwa zum b\"urokratischen oder literarischen Feld (Bourdieu 1999, 2004), historisch zu rekonstruieren. Unser Beitrag versucht daher, die Genese des gelehrten Feldes vom Mittelalter bis zum Beginn der Moderne zu skizzieren, und diskutiert damit gleichzeitig M\"oglichkeiten und Grenzen von Feldanalysen in der Geschichtswissenschaft.},
  isbn = {978-3-531-94259-9},
  langid = {ngerman},
  file = {C:\Users\lucan\Zotero\storage\ES8Y7WWP\Füssel und Trüter - 2012 - Das gelehrte Feld der Vormoderne. Möglichkeiten und Grenzen von Feldanalysen in der Geschichtswissen.pdf}
}

@misc{funk,
  title = {Towards {{Ontology Construction}} with {{Language Models}}},
  author = {Funk, Maurice and Hosemann, Simon and Jung, Jean Christoph and Lutz, Carsten},
  abstract = {Der Beitrag stellt einen neuartigen Ansatz zur (semi-)automatischen Konstruktion von Ontologien mithilfe gro\ss er Sprachmodelle (LLMs) vor. Im Fokus steht zun\"achst die Generierung einer Konzept-Hierarchie (is-a-Relation) f\"ur eine gegebene Dom\"ane, ausgehend von einem Seed-Konzept (z. B. Animals, Drinks, Music). Anders als klassische Ontologie-Lernverfahren, die ein vorab definiertes Schema voraussetzen, nutzt der Ansatz die F\"ahigkeit von LLMs, relevante Konzeptbezeichnungen selbst vorzuschlagen und hierarchisch zu strukturieren. Der entwickelte Algorithmus ,,crawlt`` die Hierarchie iterativ: F\"ur jedes entdeckte Konzept werden m\"ogliche Subkonzepte erfragt (,,Existence`` und ,,Listing``), durch zus\"atzliche Prompts verifiziert (,,Verification``) und mittels eines modifizierten KRIS-Klassifikationsalgorithmus in eine transitive, azyklische Hierarchiestruktur (DAG) eingef\"ugt. Dabei werden typische LLM-Fehler systematisch adressiert, darunter: - Dom\"anenwechsel durch zu generische Begriffe - Attributinflation (\"uberm\"a\ss ig spezifische, irrelevante Klassen) - Halluzinationen - Verwechslung von Subsumption mit Instanz- oder Teil-Ganzes-Relation Zur Verbesserung der Qualit\"at werden Frequenzsampling, Prompt-Engineering und mehrstufige Validierung eingesetzt. Synonym-Erkennung und Konsistenzpr\"ufung erfolgen ebenfalls \"uber zus\"atzliche LLM-Abfragen. Die Methode wurde mit GPT-3.5 in verschiedenen Dom\"anen getestet (u. a. Animals, Plants, Diseases, Goats, Music). Die resultierenden Hierarchien zeigen eine hohe strukturelle Plausibilit\"at, wenngleich sie unvollst\"andig bleiben und vereinzelt Fehler enthalten. Eine objektive Evaluation ist mangels ,,Ground Truth`` schwierig; daher erfolgt die Bewertung prim\"ar qualitativ durch manuelle Inspektion. Der Beitrag argumentiert, dass LLMs erhebliches Potenzial f\"ur die Unterst\"utzung der Ontologieentwicklung besitzen -- insbesondere bei der Generierung von Konzeptvorschl\"agen und der initialen Strukturierung von Dom\"anenwissen. Gleichzeitig wird betont, dass vollst\"andige Automatisierung nicht das Ziel sein sollte; vielmehr erscheint eine Kombination aus LLM-Unterst\"utzung und menschlicher Dom\"anenexpertise als zukunftsweisender Ansatz. Als weiterf\"uhrende Perspektiven werden genannt: Integration menschlicher Interaktion Erweiterung auf expressive Ontologiesprachen (OWL) Evaluationsmethoden f\"ur LLM-generierte Ontologien Untersuchung kultureller und epistemischer Bias in LLM-basierten Konzeptstrukturen Der Beitrag markiert damit einen fr\"uhen, methodisch reflektierten Schritt hin zu einer systematischen Nutzung von LLMs im Ontology Engineering.}
}

