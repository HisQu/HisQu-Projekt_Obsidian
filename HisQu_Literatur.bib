@misc{zotero-item-6743,
  title = {Enhancing {{Explainability}} in {{Multimodal Large Language Models Using Ontological Context}}},
  author = {Amara, Jihen and {K{\"o}nig-Ries}, Birgitta and Samuel, Sheeba},
  year = 2024,
  month = sep,
  abstract = {Der Beitrag entwickelt ein hybrides Framework zur Verbesserung der Explainability von Multimodal Large Language Models (MLLMs) durch die Integration ontologischen Wissens. W\"ahrend MLLMs starke Leistungen in visuell-textuellen Aufgaben zeigen, bestehen weiterhin Probleme hinsichtlich Halluzination, mangelnder dom\"anenspezifischer Pr\"azision und fehlender Transparenz. Die Autor:innen schlagen ein dreifaches Integrationsmodell vor: (1) ontologiegest\"utztes Prompting zur semantischen Kontextanreicherung,  (2) ontologiebasierte Evaluation der Konzeptidentifikation und  (3) Nutzung description-logischer Reasoner zur erkl\"arbaren Klassifikation. Das Ganze wird an dem Beispiel der Reispflanzenkrankheitsdiagnose wird gezeigt aufgezeigt. Die empirischen Ergebnisse zeigen, dass die Kombination von Ontologie und MLLM sowohl die semantische Pr\"azision als auch die Transparenz der Klassifikation verbessert. Gleichzeitig werden modelltypische Biases sichtbar gemacht. Der Ansatz demonstriert das Potenzial einer synergetischen Verbindung von symbolischer Wissensrepr\"asentation und generativer KI f\"ur dom\"anenspezifische, erkl\"arbare Entscheidungsprozesse und er\"offnet Perspektiven f\"ur eine vertrauensw\"urdigere multimodale KI.}
}

