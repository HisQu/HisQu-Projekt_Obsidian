@article{SchwarzKARRIERELEONBATTISTAALBERTISPAPSTLICHENKANZLEI,
  title = {{{DIE KARRIERE LEON BATTISTA ALBERTIS IN DER P\"APSTLICHEN KANZLEI}}},
  author = {Schwarz, Brigide},
  year = 2014,
  month = jan,
  journal = {Quellen und Forschungen aus italienischen Archiven und Bibliotheken},
  volume = {93},
  number = {1},
  issn = {1865-8865, 0079-9068},
  doi = {10.1515/qfiab.2014.93.1.49},
  urldate = {2026-05-29},
  abstract = {RIASSUNTO             Che Leon Battista Alberti adempisse nella cancelleria papale ai compiti di abbreviatore e scriptor, si sa da molti anni, e dal 2008 pure che nel 1449 divenne lettore per l'Audientia litterarum contradictarum. Nel presentecontributo si precisano meglio l'arco temporale dei suoi uffici, inquadrando in questa sua carriera anche la funzione, altrettanto nota, di segretario del capo cancelliere. Riguardo ai singoli uffici, se ne analizzano da una parte le mansioni, le procedure e l'organizzazione, e dall'altra parte l'ordinamento corporativo e confraternale dei funzionari. Vengono evidenziate le possibilit\`a di cui disponeva Alberti per cercare e curare contatti e ottenere da insider delle informazioni in anticipo, traendone vantaggio per l'allargamento e la gestione della sua personale rete di contatto. Si esaminano i fattori che determinarono la carriera di Alberti nella cancelleria, lunga 41 anni, e si valuta il successo ottenuto in confronto con le carriere dei suoi colleghi.},
  file = {C:\Users\lucan\Zotero\storage\43RW6VYS\Schwarz - 2014 - DIE KARRIERE LEON BATTISTA ALBERTIS IN DER PÄPSTLICHEN KANZLEI.pdf}
}

