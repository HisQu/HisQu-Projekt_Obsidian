@article{pollinWhenItWas2025,
  title = {When It Was 2024 -- {{Generative AI}} in the Field of Digital Scholarly Editions},
  author = {Pollin, Christopher and Fischer, Franz and Sahle, Patrick and Scholger, Martina and Vogeler, Georg},
  year = 2025,
  journal = {Zeitschrift f\"ur digitale Geisteswissenschaften},
  volume = {10},
  publisher = {Forschungsverbund Marbach Weimar Wolfenb\"uttel / Digital Humanities im deutschsprachigen Raum e. V.},
  issn = {2510-1358},
  doi = {10.17175/2025_008},
  urldate = {2025-12-08},
  abstract = {Der Beitrag reflektiert den aktuellen Forschungsstand zur Anwendung generativer KI im Bereich der digitalen wissenschaftlichen Edition. Er basiert auf Experimenten, die 2024 bei einem DHd-Workshop pr\"asentiert und diskutiert wurden, und bezieht weitere Publikationen zum Thema ein. Die Untersuchung identifiziert acht Anwendungsfelder generativer KI, vorwiegend in Form von Large Language Models (LLMs), in der wissenschaftlichen Editorik: (1.) Dokumentation der Text\"uberlieferung, (2.) Nachbearbeitung retrodigitalisierter Editionen, (3.) Textgewinnung und -codierung (Transkription, Dokument-Layout-Analyse, OCR~/ HTR-Nachbearbeitung, grundlegendes Markup), (4.) Normalisierung, (5.) Erkennung von Named Entities (NER) und tiefere semantische Annotation, (6.) Informationsanreicherung, (7.) \"Ubersetzung und (8.) Zusammenfassung. In den durchgef\"uhrten Experimenten wurde der Einsatz generativer KI im gesamten Editionsprozess konzeptualisiert, auch wenn sich NER als Bereich mit den meisten Beitr\"agen erwies. Im abschlie\ss enden Teil des Beitrags werden Erfordernisse an die weitere Forschung benannt: Aus praktischer Perspektive m\"ussen standardisierte Workflow-Orchestrierungen und Evaluationsprotokolle entwickelt werden. Aus theoretischer Sicht bedarf es systematischer Untersuchungen m\"oglicher St\"arken und Schw\"achen von LLMs bei deren Verwendung in digitalen Editionen sowie einer kritischen Reflexion \"uber inh\"arente Schieflagen und ethische Fragen.},
  langid = {english},
  keywords = {Digitale Edition,Experiment,Kunstliche Intelligenz,Optische Zeichenerkennung,Transkription},
  file = {C:\Users\lucan\Zotero\storage\KFLLXYND\PollinWhenitwas2024GenerativeAIfielddigitalscholarlyeditions.pdf}
}

