@book{LeppinGottesspurenchristlicheEuropavorseinerEntzauberungVomMittelalterbiszurAufklaerung,
  title = {{Gottesspuren. Das christliche Europa vor seiner Entzauberung. Vom Mittelalter bis zur Aufkl\"arung}},
  shorttitle = {{Gottesspuren. Das christliche Europa vor seiner Entzauberung}},
