  author = {Askar, Majid and Algergawy, Alsayed and Soliman, Taysir Hassan A. and {K{\"o}nig-Ries}, Birgitta},
  year = 2020,
  abstract = {Der Beitrag adressiert eine zentrale Herausforderung im Kontext von Ontology-Based Data Access (OBDA): die \"Ubersetzung nat\"urlicher Sprachabfragen (Natural Language Queries, NLQ) in formale SPARQL-Queries. W\"ahrend OBDA-Systeme wie Ontop oder MASTRO SPARQL als Anfragesprache verwenden, stellt diese f\"ur Endnutzer:innen eine erhebliche H\"urde dar. Ziel der Arbeit ist die Entwicklung eines interaktiven, ontologiebasierten Query-Translators, der nat\"urliche Sprache verarbeitet und unter Einbeziehung der Nutzer:innen in SPARQL transformiert. Die vorgeschlagene Architektur besteht aus vier Hauptkomponenten:  (1) User Query Handler,  (2) Concept Matcher,  (3) User Interaction und  (4) SPARQL Query Builder.  Zun\"achst wird die nat\"urliche Sprache mittels NLP-Techniken (Tokenisierung, Stop-Word-Removal, Stemming, Singularisierung) vorverarbeitet. Anschlie\ss end erfolgt ein mehrstufiges Matching der Query-Terme gegen Ontologieklassen und -properties (Exact Match, WordNet-Synonyme, kombinierte String-Similarit\"at). Ein zentrales Merkmal des Ansatzes ist die explizite Einbindung der Nutzer:innen in einem Zwischenschritt, in dem gefundene Ontologie-Elemente best\"atigt, entfernt oder erg\"anzt werden k\"onnen. Auf Basis der validierten Konzepte werden vollst\"andige oder partiell rekonstruierte RDF-Triple gebildet, aus denen SPARQL-Queries generiert und gerankt werden. Die Evaluation erfolgt anhand des QALD-Benchmarks unter Verwendung von Precision, Recall und F-Measure. Die Ergebnisse zeigen, dass insbesondere die Zwischeninteraktion mit Nutzer:innen sowie die Nutzung von Singular-/Plural-Varianten die \"Ubersetzungsqualit\"at verbessern. Der Beitrag demonstriert damit einen praxisorientierten, hybriden Ansatz, der ontologiebasierte Semantik, NLP-Techniken und partizipative Nutzerf\"uhrung kombiniert, um die Zug\"anglichkeit von OBDA-Systemen f\"ur Nicht-Expert:innen zu erh\"ohen.}
}

@misc{zotero-item-6745,
  title = {Towards the {{Automation}} of {{Knowledge Graph Construction Using Large Language Models}}},
  author = {Kommineni, Vamsi Krishna and {K{\"o}nig-Ries}, Birgitta and Samuel, Vamsi Krishna Kommineni; Birgitta K{\"o}nig-Ries; Sheeba and Samuel, Sheeba},
  year = 2024,
  month = sep,
  abstract = {Der Beitrag von Kommineni et al. untersucht die (semi-) automatische Konstruktion von Ontologien und Knowledge Graphs mithilfe gro\ss er Sprachmodelle (LLMs). Aufbauend auf klassischen Ontology-Engineering-Prinzipien wird eine sechsstufige Pipeline entwickelt, die von der Generierung von Competency Questions \"uber die Ontologieerstellung bis zur Knowledge-Graph-Bef\"ullung und Evaluation reicht. Verschiedene state-of-the-art LLMs (Mixtral, GPT-4o, GPT-3.5, Gemini) werden systematisch verglichen. Die Ergebnisse zeigen, dass LLMs insbesondere bei der Extraktion von Konzepten, Relationen und Instanzen erhebliche Effizienzgewinne erm\"oglichen, jedoch deutliche Unterschiede in Strukturqualit\"at und Konsistenz aufweisen. Ein Human-in-the-loop-Ansatz wird daher ausdr\"ucklich empfohlen.}
}

@misc{zotero-item-6746,
  title = {Towards a {{Core Ontology}} for {{Hierarchies}} of {{Hypotheses}} in {{Invasion Biology}}},
  author = {Algergawy, Alsayed and Stangneth, Ria and Heger, Tina and Jeschke, Jonathan M.},
  abstract = {Der Beitrag von Algergawy et al. entwickelt eine Core Ontology f\"ur die formale Modellierung von Hierarchien wissenschaftlicher Hypothesen am Beispiel der Invasionsbiologie. Ausgangspunkt ist der sogenannte Hierarchy-of-Hypotheses (HoH)-Ansatz, der \"ubergeordnete Hypothesen in zunehmend spezifische, empirisch testbare Sub-Hypothesen strukturiert. Bislang existierte diese Struktur jedoch ausschlie\ss lich als konzeptuelles Modell ohne formale Semantik. Zur Schlie\ss ung dieser L\"ucke verfolgen die Autor:innen eine Fusion/Merge-Strategie, bei der relevante Begriffe aus zw\"olf zentralen Hypothesen extrahiert, geeignete bestehende Ontologien \"uber BioPortal identifiziert und validiert sowie mittels Modul-Extraktion auf wesentliche Konzepte reduziert werden. Die resultierenden Module werden zu einer Core Ontology zusammengef\"uhrt, die sechs zentrale Kernkonzepte umfasst und als formale Grundlage f\"ur die semantische Modellierung von Hypothesenstrukturen dient. Dadurch wird eine maschinenlesbare Repr\"asentation geschaffen, die zuk\"unftige computerunterst\"utzte Aktualisierungen, Evidenzzuordnungen und Inferenz erm\"oglicht.}
}

@inproceedings{zotero-item-6747,
  title = {What to {{Do When}} the {{Users}} of an {{Ontology Merging System Want}} the {{Impossible}}? {{Towards Determining Compatibility}} of {{Generic Merge Requirements}}},
  booktitle = {22nd {{International Conference}}, {{EKAW}} 2020},
  author = {Babalou, Samira and Grygorova, Elena and {K{\"o}nig-Ries}, Birgitta},
  year = 2020,
  month = sep,
  pages = {20--36},
  publisher = {Springer},
  address = {Bolzano, Italy},
  abstract = {Der Beitrag untersucht ein bislang wenig formalisiertes Problem der Ontologieintegration: die gleichzeitige Erf\"ullbarkeit generischer Merge-Anforderungen. Nutzer:innen von Ontologie-Merging-Systemen formulieren h\"aufig Anforderungen wie Erhalt aller Entit\"aten, Minimierung von Redundanz, Konsistenzwahrung oder vollst\"andige Informationsintegrationanforderungen, die sich in bestimmten Kombinationen logisch widersprechen k\"onnen. Die Autorinnen analysieren typische Merge-Anforderungen und modellieren diese formal als logische Constraints. Auf dieser Grundlage wird untersucht, welche Kombinationen von Anforderungen kompatibel sind und welche prinzipiell nicht gleichzeitig erf\"ullbar sind. Dabei werden strukturelle Zielkonflikte sichtbar, etwa zwischen Redundanzreduktion und vollst\"andiger Strukturtreue oder zwischen Inferenzbewahrung und Konsistenzsicherung. Der Beitrag liefert damit einen theoretischen Rahmen zur systematischen Vorabpr\"ufung von Merge-Anforderungen und pl\"adiert f\"ur eine explizite Priorisierung sowie Transparenz gegen\"uber Nutzer:innen \"uber inh\"arente Trade-offs in Integrationsprozessen.}
}

@misc{zotero-item-6748,
  title = {Why the {{Mapping Process}} in {{Ontology Integration Deserves Attention}}},
  author = {Babalou, Samira and Algergawy, Alsayed and Lantow, Birger and {K{\"o}nig-Ries}, Birgitta},
  year = 2017,
  month = dec,
  abstract = {Der Beitrag analysiert die zentrale Rolle des Mappings im Prozess der Ontologieintegration. W\"ahrend Ontologieintegration typischerweise in vier Phasen  -- Pre-processing,  - Mapping,  - Merging und  - Post-processing  ... unterteilt wird, argumentieren die Autor:innen, dass insbesondere der Mapping-Schritt konzeptionell wie praktisch die gr\"o\ss te Herausforderung darstellt. Anhand eines strukturierten Workflows und konkreter Beispiele (u. a. MeSH, SNOMED-CT, EHDAA) wird gezeigt, wie linguistische, strukturelle und semantische Heterogenit\"aten zu Inkonsistenzen, Redundanzen und semantischer \"Uberlappung f\"uhren k\"onnen, wenn Mapping-Ergebnisse unreflektiert in den Merge-Prozess \"ubernommen werden. Der Artikel identifiziert zentrale Designentscheidungen im Mapping-Prozess, diskutiert Merging-Strategien (symmetrisch vs. asymmetrisch) und beleuchtet Herausforderungen bei Large-Scale-Ontologien. Besonders hervorgehoben werden offene Forschungsfragen hinsichtlich Evaluationsmethoden, Informationsverlust, Mehrsprachigkeit sowie der Integration komplexer n:m-Korrespondenzen. Insgesamt pl\"adiert der Beitrag f\"ur eine st\"arkere methodische und theoretische Fokussierung auf das Mapping als Kernproblem der Ontologieintegration.}
}

@misc{zotero-item-6749,
  title = {Assessing the {{Capability}} of {{Large Language Models}} for {{Domain-Specific Ontology Generation}}},
  author = {Lippolis, Anna Sofia and Saeedizade, Mohammad Javad and Keskis{\"a}rkk{\"a}, Robin and Gangemi, Aldo and Blomqvist, Eva and Nuzzolese, Andrea Giovanni},
  year = 2025,
  abstract = {Der Beitrag untersucht systematisch, inwieweit Large Language Models (LLMs) mit expliziten Reasoning-F\"ahigkeiten f\"ur die dom\"anenspezifische Ontologiegenerierung geeignet sind. Aufbauend auf fr\"uheren Studien zur LLM-gest\"utzten Ontologieerstellung wird hier erstmals die Generalisierbarkeit \"uber mehrere fachlich unterschiedliche Dom\"anen hinweg analysiert. Die Autor:innen evaluieren zwei reasoning-f\"ahige Modelle -- OpenAI o1-preview und DeepSeek anhand eines kuratierten Datensatzes von 95 Competency Questions (CQs) mit zugeh\"origen User Stories aus sechs realen Ontologieprojekten: Circular Economy, Music, Events, Microbe Habitat, Carbon and Nitrogen Cycling sowie Water and Health. Die Ontologien werden jeweils unabh\"angig pro CQ generiert (,,Independent Ontology Generation``), wobei eine strukturierte Few-Shot-Prompting-Strategie mit Beispielontologie eingesetzt wird. Die Bewertung erfolgt anhand eines klar definierten Modellierungskriteriums: Eine CQ gilt als modelliert, wenn eine SPARQL-Abfrage existiert, mit der sich ihre Antwort aus der erzeugten Ontologie extrahieren l\"asst. Zus\"atzlich werden ,,minor issues`` (z. B. fehlende einzelne Properties) gesondert klassifiziert. Die Ergebnisse zeigen: - Hohe und konsistente Modellierungsraten in allen sechs Dom\"anen - Keine signifikanten Leistungseinbu\ss en bei komplexeren (,,hard``) CQs - Vergleichbare Gesamtperformance beider Reasoning-Modelle - Unterschiedliche Fehlertypen (o1-preview: eher kleinere Modellierungsfehler; DeepSeek: eher unvollst\"andige Modellierung) Die Resultate belegen, dass reasoning-f\"ahige LLMs in der Lage sind, Ontologiegenerierung dom\"anenunabh\"angig zu generalisieren. Gleichzeitig weisen die Autor:innen auf Limitationen hin, darunter m\"ogliche Dataset-Leakage-Effekte, die Beschr\"ankung auf zwei Modelle sowie den hohen Ressourcenbedarf reasoning-basierter LLMs. Der Beitrag liefert damit eine empirisch fundierte Grundlage f\"ur die Einsch\"atzung der Skalierbarkeit und Robustheit automatisierter Ontologieentwicklung mittels LLMs und stellt einen wichtigen Schritt in Richtung dom\"anenagnostischer, KI-gest\"utzter Wissensmodellierung dar.}
}

@misc{zotero-item-6752,
  title = {{Ontologies in the Era of Large Language Models -- A Perspective}},
  author = {Neuhaus, Fabian},
  year = 2023,
  month = dec,
  abstract = {Der Beitrag diskutiert die Konsequenzen des Aufkommens gro\ss er Sprachmodelle (LLMs) f\"ur das Feld der Angewandten Ontologie. Ausgangspunkt ist die Beobachtung, dass LLMs, anders als fr\"uhere maschinelle Lernverfahren, als generalistische Werkzeuge in nat\"urlicher Sprache kommunizieren, Begriffe definieren und scheinbar wissensbasierte Antworten liefern k\"onnen. Damit \"ubernehmen sie Funktionen, die traditionell mit Ontologien assoziiert werden, etwa Terminologiedefinition und Wissensrepr\"asentation in formaler Sprache (z. B. OWL). Neuhaus stellt zwei provokante Fragen: (1) Werden Ontologien im Zeitalter der LLMs obsolet? (2) Werden Ontolog:innen \"uberfl\"ussig, wenn LLMs Ontologien automatisch generieren k\"onnen? Der Autor argumentiert differenziert, dass Ontologien keineswegs \"uberfl\"ussig werden. W\"ahrend LLMs f\"ur bestimmte Zwecke (etwa im Kontext genereller KI-Ambitionen) leistungsf\"ahig sind, erf\"ullen Referenzontologien weiterhin zentrale Funktionen, insbesondere hinsichtlich kontrollierter Terminologien, Interoperabilit\"at, Transparenz und erkl\"arbarer Wissensrepr\"asentation. Anders als LLMs speichern Ontologien Wissen symbolisch, \"uberpr\"ufbar und logisch konsistent. Zugleich warnt der Beitrag vor einer naiven Gleichsetzung von LLM-Ausgaben mit impliziten, koh\"arenten Ontologien. Zwei zentrale Herausforderungen werden identifiziert: Fehlende logische Konsistenz: LLMs sind nicht darauf ausgelegt, globale Widerspruchsfreiheit sicherzustellen. Beispiele wie logische R\"atsel oder fehlerhafte Inferenzketten (vgl. Abb. 2, S. 404) zeigen, dass sie grundlegende logische Anforderungen verletzen k\"onnen. Ambiguit\"at und Kontextabh\"angigkeit: LLMs navigieren Mehrdeutigkeiten probabilistisch, anstatt sie explizit ontologisch zu disambiguieren. Dadurch entstehen inkonsistente oder kontextabh\"angige Kategorisierungen (z. B. ,,cave`` als physisches Objekt oder nicht), was der Zielsetzung eindeutiger ontologischer Definitionen widerspricht. Ein zentrales Argument des Beitrags lautet, dass Ontologieentwicklung nicht prim\"ar ein Extraktionsproblem, sondern ein Konsensbildungsprozess ist. Automatische Ontologiegenerierung aus Text verkennt, dass in wissenschaftlichen Gemeinschaften unterschiedliche, teils widerspr\"uchliche Begriffsverwendungen existieren. Ontolog:innen moderieren diese Differenzen und etablieren gemeinschaftlich akzeptierte Definitionen. Das sei eine Aufgabe, die LLMs strukturell NICHT leisten k\"onnen. Abschlie\ss end pl\"adiert der Beitrag f\"ur eine realistische Integration von LLMs in semi-automatische Ontologieentwicklungsprozesse. LLMs k\"onnen produktivit\"atssteigernde Werkzeuge sein (z. B. zur Axiomgenerierung oder Ontologieerweiterung), ersetzen jedoch weder Ontologien als formale Wissensartefakte noch Ontolog:innen als epistemische Vermittler und Konsensstifter.},
  langid = {Englisch}
}

@misc{zotero-item-6753,
  title = {{Ontologies Supporting Research-Related Information Foraging Using Knowledge Graphs: Literature Survey and Holistic Model Mapping}},
  author = {Nguyen, Viet Bach and Sv{\'a}tek, Vojt{\v e}ch and Rabby, Gollam and Corcho, Oscar},
  year = 2020,
  abstract = {Der Beitrag pr\"asentiert eine systematische Literaturstudie zu Ontologien, die Forschungsinformationen in Knowledge Graphs modellieren, und entwickelt darauf aufbauend ein holistisches Mapping-Modell. Ausgangspunkt ist das Konzept des ,,Information Foraging``, das beschreibt, wie Forschende gezielt Informationen suchen, filtern und kombinieren. Die Autor:innen analysieren bestehende Ontologien f\"ur Publikationen, Forschungsprojekte, Personen, Organisationen, Forschungsdaten und Zitationsbeziehungen und identifizieren strukturelle \"Uberlappungen sowie konzeptionelle L\"ucken. Auf Basis dieser Analyse wird ein \"ubergreifendes konzeptionelles Modell entwickelt, das zentrale Entit\"aten wie Research Object, Research Activity, Research Agent und Research Output integriert. Das Ergebnis ist ein Mapping-Rahmen, der Interoperabilit\"at zwischen bestehenden Ontologien erleichtert und eine nutzerzentrierte, ganzheitliche Modellierung wissenschaftlicher Informationsr\"aume unterst\"utzt.},
  langid = {Englisch}
}

@misc{zotero-item-6754,
  title = {{{OI-LLM}}: {{A Scalable Framework}} to {{Integrate Large Scale Ontologies Using Large Language Model}}},
  author = {Pardeshi, Sujata and Giri, Virat and Gawade, Sushopti},
  year = 2025,
  month = may,
  abstract = {Der Beitrag stellt mit OI-LLM ein skalierbares Framework zur Integration gro\ss skaliger Ontologien vor, das Large Language Models (LLMs) mit naturinspirierten Optimierungsverfahren kombiniert. Ausgangspunkt ist die Beobachtung, dass klassische Ontology-(Meta)-Matching-Verfahren (OMM) bei gro\ss en Ontologien erhebliche Rechenzeit und Speicherressourcen beanspruchen, insbesondere durch die Berechnung multipler \"Ahnlichkeitsmatrizen und gewichteter Aggregationen. Das vorgeschlagene Framework geh\"ort zur Kategorie OIT3 (Integration ohne explizite Referenz-Alignments) und adressiert die zentrale Herausforderung der Skalierbarkeit durch drei Kernmechanismen: - Partitionierung gro\ss er RDF-Graph-Ontologien - Zerlegung in Subontologien anhand von Super- und Subklassenstrukturen - Reduktion des Suchraums ohne strukturelle Zerst\"orung - Load Balancing mittels Ant Colony Optimization (ACO) - Parallele Verteilung von Matching-Aufgaben auf mehrere Recheneinheiten - Dynamische Anpassung der Arbeitswahrscheinlichkeiten - Identifikation und Ausschluss ineffizienter Knoten (,,compromised nodes``) - LLM-gest\"utzte semantische \"Ahnlichkeitsbestimmung - Ersetzung klassischer syntaktischer/semantischer Similarity-Metriken - API-basierte Abfragen zur bin\"aren oder hierarchischen Klassifikation - Vermeidung komplexer gewichteter Aggregationsmechanismen Die Evaluation erfolgt am OAEI Anatomy Track (Human Anatomy vs. Adult Mouse Anatomy, 3304 bzw. 2744 Klassen). Das System wird in einer virtualisierten Cloud-Umgebung mit parallelen Llama-3-8B-Instanzen implementiert. Im Vergleich zu bestehenden LLM-basierten Matching-Frameworks (z. B. OLaLa, LLMA Dialog Model) reduziert OI-LLM die Integrationszeit signifikant auf 00:49:50 (HH:MM:SS) und erreicht dabei: - Wahrung der semantischen Konsistenz - Vermeidung struktureller Redundanz - Erhaltung der Wissensbasis der Quellontologie - Koh\"arente integrierte Ontologie (gemessen \"uber Graphmetriken) Der Beitrag demonstriert, dass die Kombination aus graphbasierter Partitionierung, parallelisiertem ACO-Load-Balancing und LLM-gest\"utzter Similarit\"atsbewertung eine praktikable und effiziente L\"osung zur Integration gro\ss skaliger Ontologien darstellt. Zugleich zeigt er einen Weg auf, wie symbolische Wissensrepr\"asentation und generative KI methodisch integriert werden k\"onnen, um sowohl Rechenkomplexit\"at als auch manuelle Interventionsbedarfe zu reduzieren.}
}

@inproceedings{zotero-item-6755,
  title = {{Navigating Ontology Development with Large Language Models}},
  booktitle = {{22nd International Conference}},
  author = {Saeedizade, Mohammad Javad and Blomqvist, Eva},
  year = 2020,
  month = sep,
  pages = {255--270},
  publisher = {Springer},
  abstract = {Der Beitrag untersucht, wie Large Language Models (LLMs) systematisch in den Prozess der Ontologieentwicklung integriert werden k\"onnen. Anstatt LLMs als vollautomatische Generatoren von Ontologien zu betrachten, analysieren die Autor:innen ihre Rolle als unterst\"utzende Werkzeuge entlang klassischer Phasen des Ontology Engineering, also von der Anforderungsanalyse \"uber Konzeptualisierung und Formalisierung bis hin zur Evaluation. Die Studie zeigt, dass LLMs insbesondere bei der Generierung erster Modellierungsentw\"urfe, bei der Formulierung von Competency Questions sowie bei der sprachlichen Dokumentation wertvolle Unterst\"utzung leisten k\"onnen. Gleichzeitig treten typische strukturelle und logische Fehler auf, darunter inkonsistente Hierarchien, fehlerhafte Restriktionen und redundante Modellbestandteile. Die Qualit\"at der Ergebnisse h\"angt stark von Promptgestaltung, Aufgabenzerlegung und menschlicher Nachkontrolle ab. Die Autor:innen pl\"adieren daher f\"ur einen methodisch eingebetteten, iterativen Human-in-the-loop-Ansatz, bei dem LLMs als kognitive Assistenzsysteme fungieren. Der Beitrag liefert einen konzeptionellen Orientierungsrahmen (,,Navigating``) f\"ur die reflektierte Nutzung generativer KI im Ontology Engineering und leistet damit einen wichtigen Beitrag zur Weiterentwicklung hybrider, neuro-symbolischer Wissensmodellierungsprozesse.},
  langid = {Englisch}
}

@inproceedings{zotero-item-6756,
  title = {Towards a {{Reference Ontology}} of {{Trust}}},
  booktitle = {Confederated {{International Conferences}}: {{CoopIS}}, {{ODBASE}}, {{C}}\&{{TC}} 2019},
  author = {Amaral, Glenda and Sales, Tiago Prince and Guizzardi, Giancarlo and Porello, Daniele},
  year = 2019,
  pages = {3--21},
  publisher = {Springer Nature Switzerland},
  abstract = {Der Beitrag entwickelt eine Reference Ontology of Trust, um die konzeptuelle \"Uberladung und terminologische Uneinheitlichkeit des Vertrauensbegriffs in unterschiedlichen Disziplinen (Soziologie, Psychologie, \"Okonomie, Informatik) zu adressieren. Ausgangspunkt ist die Beobachtung, dass ,,Trust`` h\"aufig unterschiedlich definiert wird und bislang keine formal fundierte, disziplin\"ubergreifend anschlussf\"ahige Ontologie existiert. Die Autor:innen f\"uhren eine tiefgehende ontologische Analyse des Vertrauensbegriffs durch, die auf der Unified Foundational Ontology (UFO) basiert. Vertrauen wird als komplexer mentaler Zustand eines Trustors modelliert, bestehend aus einer intentionellen Komponente (Zielbezug) sowie mehreren belief-basierten Komponenten hinsichtlich F\"ahigkeiten, Intentionen und Vulnerabilit\"aten eines Trustees. Dabei wird explizit zwischen zwei zentralen Formen unterschieden: - Social Trust (Vertrauen in einen agentiven Akteur) - Institution-based Trust (Vertrauen in soziale Systeme, z. B. Rechtssystem, W\"ahrungssystem) Ein zentrales theoretisches Ergebnis ist die formale Explikation der Beziehung zwischen Vertrauen und Risiko: Vertrauen impliziert stets eine Situation von Unsicherheit und potenzieller Verwundbarkeit. Risiko entsteht aus der M\"oglichkeit, dass das erwartete Verhalten des Trustees ausbleibt oder negative Konsequenzen eintreten. Die Ontologie integriert zudem quantitative Aspekte (Trust Degree), unterscheidet zwischen mentalen und sozialen Momenten (gem\"a\ss{} UFO) und modelliert soziale Systeme als funktionale Komplexe mit normativen Strukturen. Abschlie\ss end wird die Referenzontologie anhand zweier Fallbeispiele validiert (Social Trust und Institution-based Trust) sowie mit bestehenden Vertrauensontologien verglichen. Der Beitrag liefert damit eine formal fundierte, interdisziplin\"ar anschlussf\"ahige Referenzstruktur zur Modellierung von Vertrauensph\"anomenen in sozialen, organisationalen und technologischen Kontexten -- insbesondere relevant f\"ur Multi-Agenten-Systeme, sozio-technische Infrastrukturen und semantische Wissensmodellierung.}
}

@misc{zotero-item-6758,
  title = {{Editorial: Volume II Special Issue on Ontologies and Large Language Models}},
  author = {Beverley, John},
  year = 2025,
  abstract = {Das Editorial f\"uhrt in den zweiten Band des Special Issue ,,Ontologies and Large Language Models`` der Zeitschrift Applied Ontology ein. Es positioniert die aktuelle Forschung an der Schnittstelle von symbolischer Wissensrepr\"asentation und statistischen KI-Methoden als ein zunehmend konvergierendes Feld, in dem Ontologien und Large Language Models (LLMs) nicht nur komplement\"ar, sondern wechselseitig verst\"arkend wirken. Der Beitrag betont, dass die rasante Entwicklung von LLMs das Interesse an strukturierter, semantisch fundierter Wissensrepr\"asentation neu belebt hat. W\"ahrend LLMs Ontologien generieren, populieren oder implizite ontologische Annahmen reproduzieren, wird es immer dringlicher, deren epistemische und methodische Implikationen systematisch zu untersuchen. Der Band versammelt acht Beitr\"age, die unterschiedliche Perspektiven auf diese Schnittstelle beleuchten, darunter: - Analyse impliziter ontologischer Commitments in LLM-Ausgaben - Skalierbare Ontologieintegration mit hybriden LLM-Algorithmen - LLM-gest\"utzte Ontologielern-Workflows - Kombination ontologischer Strukturen mit Deep-Learning-Architekturen  -Ontologiegest\"utzte Reduktion von Halluzinationen in Retrieval-Augmented Generation - LLM-basierte Ontologiepopulation - Unterst\"utzung nicht-expertischer Nutzer:innen beim Ontologieaufbau - Transformation zwischen Text und kausalen Modellen Das Editorial argumentiert, dass sich ein Paradigmenwechsel abzeichnet: LLMs und Ontologien sind nicht nur parallel existierende Technologien, sondern bilden gemeinsam eine neue methodische Grundlage f\"ur Wissensmodellierung und KI-Systeme. Zugleich wird betont, dass die Forschung in diesem Bereich noch jung ist und eine sorgf\"altige methodische Fundierung ben\"otigt. Der Beitrag versteht den Band als Dokumentation eines sich etablierenden Forschungsfeldes und als Impulsgeber f\"ur zuk\"unftige interdisziplin\"are Kooperationen zwischen Ontologie-Engineering und generativer KI.},
  langid = {Englisch}
}

@misc{zotero-item-6759,
  title = {From {{Human-}} to {{LLM-Centered Collaborative Ontology Engineering}}},
  author = {Doumanas, Dimitrios and Bouchouras, Georgios and Soularidis, Andreas and Kotis, Konstantinos and Vouros, George},
  abstract = {Der Beitrag untersucht systematisch die Transformation von einer rein menschenzentrierten Ontologieentwicklung hin zu einer LLM-zentrierten kollaborativen Ontologie-Engineering-Methodik. Ausgangspunkt ist die etablierte Human-Centered Collaborative Ontology Engineering Methodology (HCOME), die als Referenzrahmen dient. Darauf aufbauend entwickeln die Autor:innen ein vierstufiges Spektrum menschlicher und maschineller Beteiligung im Ontologieentwicklungsprozess: - Level 0 (HCOME): ausschlie\ss lich menschliche Ontologieentwicklung - Level 1 (X-HCOME): LLM-unterst\"utzte Ontologieentwicklung unter menschlicher F\"uhrung - Level 2 (SimX-HCOME): simulierte Rollen\"ubernahme durch LLMs (Knowledge Engineer, Domain Expert, Knowledge Worker) mit menschlicher Supervision - Level 3 (Sim-HCOME): vollst\"andig LLM-zentrierte, autonome Ontologieentwicklung Ziel der Studie ist es, die F\"ahigkeit von LLMs zu evaluieren, Dom\"anenwissen zu extrahieren, ontologisch zu formalisieren und kollaborative Rollen im Engineering-Prozess zu simulieren. Die Evaluation erfolgt anhand zweier Dom\"anen (Search and Rescue; Parkinson's Disease Monitoring) sowie durch den Vergleich mit referenzbasierten, rein menschlich entwickelten Ontologien. Als Bewertungsmetriken dienen Precision, Recall und F1-Score bez\"uglich Klassen, Objekt-Properties und SWRL-Regeln. Die Ergebnisse zeigen, dass LLMs die Ontologieentwicklung signifikant beschleunigen k\"onnen, insbesondere bei Wissensextraktion und Strukturvorschl\"agen. Gleichzeitig steigt mit zunehmender Automatisierung das Risiko struktureller Inkonsistenzen und semantischer Abweichungen. Die besten Resultate werden auf intermedi\"aren Kollaborationsstufen (insbesondere Level 2) erzielt, bei denen menschliche Expertise und maschinelle Generierung synergetisch kombiniert werden. Der Beitrag liefert damit einen methodisch fundierten Rahmen f\"ur Human--LLM-Kollaboration im Ontology Engineering und verdeutlicht, dass zuk\"unftige Entwicklungen nicht in vollst\"andiger Automatisierung, sondern in balancierten, rollensensitiven Kooperationsmodellen zwischen Mensch und KI liegen.}
}

@misc{zotero-item-6761,
  title = {Identity of {{Historical Localities}} in {{Information Systems}}},
  author = {Garbacz, Pawe{\l} and Szady, Bogumi{\l} and {\L}awrynowicz, Agnieszka},
  abstract = {Der Beitrag entwickelt ein ontologisches Rahmenkonzept zur Bestimmung diachroner Identit\"atskriterien historischer Lokalit\"aten (Siedlungen) in Informationssystemen, insbesondere in historischen Geoinformationssystemen (HGIS). Ausgangspunkt ist die Beobachtung, dass Datenbanktechnologien eindeutige Identifikatoren verlangen, Historiker:innen jedoch h\"aufig keine expliziten Kriterien zur Entscheidung bereitstellen, ob zwei historisch belegte Siedlungen als identisch oder verschieden zu behandeln sind. Nach einer kritischen Sichtung einschl\"agiger Ans\"atze aus Spatio-Temporal Databases, Applied Ontology, Semantic Web und Digital History argumentieren die Autor:innen, dass bislang kein operationalisierbares Identit\"atskriterium f\"ur historische Lokalit\"aten existiert. Sie schlagen daher eine eigene ontologische Analyse vor, die Lokalit\"aten als soziale Artefakte mit folgenden konstitutiven Aspekten modelliert: - Geographische Lage (footprint) - Eigenname (proper name) - Typ (z. B. Dorf, Stadt) - l-mereologische Relationen (Teil-Ganzes-Beziehungen zu anderen Lokalit\"aten) Anhand historischer Fallstudien (u. a. Umbenennung, Translokation, Fusion, Teilung, komplexe Neugr\"undungen) wird untersucht, welche Kombinationen von Ver\"anderungen als identit\"atsbewahrend gelten und welche zur Zerst\"orung oder Supplantation einer Lokalit\"at f\"uhren. Zentrale Beobachtung: Eine Lokalit\"at verliert ihre Identit\"at typischerweise dann, wenn sich ihr Eigenname und mindestens einer der Aspekte Lage, Typ oder l-mereologische Struktur \"andern. Auf dieser Grundlage wird ein ereignisbasiertes Identit\"atskriterium formuliert. Lokalit\"aten werden als Enduranten verstanden, deren Identit\"at \"uber qualitative Transformationen hinweg bestimmt wird. Entscheidend ist, ob eine Menge von Prozessen (Episode Set), an denen eine Lokalit\"at beteiligt ist, als ,,disruptiv`` oder ,,nicht-disruptiv`` hinsichtlich bestimmter Qualit\"ats\"anderungen zu klassifizieren ist. Identit\"at wird somit lokal (episodenweise) bestimmt und kann sequenziell zu einem globalen Identit\"atsverlauf aggregiert werden. Ein ausf\"uhrlicher Fallstudienteil zur Ortschaft Pasieczniki Du\.ze illustriert die praktische Anwendung des Kriteriums auf historische Karten- und Registerquellen. Dabei zeigt sich, dass die Methode sowohl mit Expertenurteilen weitgehend \"ubereinstimmt als auch explizite, nachvollziehbare Entscheidungsregeln f\"ur Datenbankimplementierungen erm\"oglicht. Der Beitrag versteht sein Modell als regulatives, operationalisierbares Fundament f\"ur HGIS-Systeme und als konzeptuelle Grundlage f\"ur formale Datenbank-Constraints. Er leistet damit einen wichtigen Beitrag zur Verbindung von Ontologie, historischer Geographie und semantischer Datenmodellierung.}
}

@misc{zotero-item-6762,
  title = {{{LLMs4OL}}: {{Large Language Models}} for {{Ontology Learning}}},
  author = {Giglou, Hamed Babaei and D'Souza, Jennifer and Auer, S{\"o}ren},
  abstract = {Der Beitrag stellt mit LLMs4OL ein konzeptionelles und empirisch fundiertes Paradigma zur Nutzung von Large Language Models (LLMs) f\"ur das Ontology Learning (OL) vor. Ziel ist es, die traditionelle, expert:innenzentrierte Ontologieentwicklung durch LLM-gest\"utzte Verfahren zu unterst\"utzen und den ,,Knowledge Acquisition Bottleneck`` zu reduzieren. Das LLMs4OL-Paradigma definiert Ontologielernen entlang zentraler ontologischer Primitive (lexikalische Einheiten, Typen, Taxonomien, nicht-taxonomische Relationen, Axiome) und operationalisiert drei Kernaufgaben: - Term Typing -- automatische Typzuweisung f\"ur lexikalische Terme - Taxonomy Discovery -- Erkennung von ,,is-a``-Hierarchien zwischen Typen - Non-Taxonomic Relation Extraction -- Identifikation semantischer Relationen jenseits der Subsumption Die Autor:innen evaluieren elf LLMs (u. a. BERT, BART, BLOOM, Flan-T5, LLaMA, GPT-3/3.5/4 sowie PubMedBERT) im Zero-Shot-Setting mithilfe systematisch konstruierter Prompt-Templates. Die Tests erfolgen \"uber mehrere Wissensdom\"anen: WordNet (lexikosemantisch), GeoNames (geographisch), UMLS-Subontologien (biomedizinisch) sowie schema.org (Webstruktur). Die Ergebnisse zeigen, dass gro\ss e, parameterstarke Modelle (insbesondere GPT-4 und Flan-T5-XL) in Taxonomie-Erkennung gute Leistungen erzielen (bis 78,1 \% F1 in UMLS), w\"ahrend Term Typing in feingranularen oder dom\"anenspezifischen Typensystemen deutlich schwieriger bleibt. Insgesamt gilt: Mit steigender Modellgr\"o\ss e verbessern sich die OL-Leistungen. In einem zweiten Schritt wird Flan-T5 mittels Instruction-Tuning feinjustiert. Die finetunten Modelle erzielen signifikante Verbesserungen (durchschnittlich +25 \% bei Term Typing, +18 \% bei Taxonomie-Erkennung), was die Notwendigkeit task-spezifischer Anpassung unterstreicht. Die Studie kommt zu dem Schluss, dass LLMs zwar nicht ohne Weiteres als autonome Ontologieentwickler geeignet sind, jedoch als leistungsf\"ahige Assistenzsysteme fungieren k\"onnen. Zuk\"unftige Forschung soll hybride Ans\"atze (LLMs + klassische OL-Verfahren), dom\"anenspezifisches Fine-Tuning, standardisierte Benchmarks sowie Human-in-the-Loop-Validierung integrieren.}
}

@misc{zotero-item-6763,
  title = {Applied {{Ontology}}: {{Where Are We Now}} and {{Where Are We Going}}?},
  author = {Hastings, Janna and Bateman, John A.},
  abstract = {Das Editorial markiert den \"Ubergang zu einer neuen Herausgeber:innen-Generation der Zeitschrift Applied Ontology und reflektiert den aktuellen Stand sowie zuk\"unftige Entwicklungen des Feldes der Angewandten Ontologie. Die Autor:innen konstatieren eine deutliche Ausweitung und Diversifizierung ontologischer Forschung in den letzten Jahren -- sowohl hinsichtlich der Anwendungsdom\"anen als auch der methodischen Ans\"atze. Ein zentrales Anliegen ist die Einf\"uhrung eines neuen Publikationsformats, des Brief Ontology Report, das speziell der Ver\"offentlichung formal korrekter, \"offentlich zug\"anglicher Ontologien dient, deren prim\"arer Beitrag in der Ressource selbst liegt. Voraussetzung sind u. a. \"offentliche Verf\"ugbarkeit, offene Lizenzierung, OWL-Formalit\"at, gute Dokumentation und klare Anwendungsbegr\"undung. Damit wird auf fr\"uhere Forderungen reagiert, ontologische Ressourcen st\"arker FAIR-konform und nutzbar zu gestalten. Ein weiterer Schwerpunkt des Editorials ist die ver\"anderte technologische Landschaft durch Deep Learning und gro\ss e vortrainierte Modelle. W\"ahrend datengetriebene Verfahren zunehmend Aufgaben der Wissensrepr\"asentation \"ubernehmen (z. B. Fragebeantwortung, Klassifikation, multimodale Verarbeitung), betonen die Autor:innen die komplement\"aren St\"arken ontologischer Ans\"atze: pr\"azise begriffliche Unterscheidungen, formale Garantien und erkl\"arbare Inferenz. Zuk\"unftig sei insbesondere eine neuro-symbolische Integration von Ontologien, Knowledge Graphs und lernbasierten Systemen von Bedeutung. Dar\"uber hinaus wird ein strukturelles Problem hervorgehoben: der Mangel an interdisziplin\"ar ausgebildeten Ontolog:innen. Die Weiterentwicklung von Lehrmaterialien, Trainingsformaten und community-basierten Initiativen (z. B. FOIS, JOWO, ESAO, ISAO) wird als zentrale Aufgabe f\"ur die Feldentwicklung benannt. Das Editorial positioniert die Zeitschrift als zentrale Plattform f\"ur Berichte zu Ontologieentwicklung, Evaluation, Integration und Wiederverwendung. Ontologieevaluation, Interoperabilit\"at und methodische Reflexion bleiben langfristige Kernherausforderungen des Feldes.}
}

@misc{zotero-item-6764,
  title = {Construction of {{Knowledge Graphs}}: {{Current State}} and {{Challenges}}},
  author = {Hofer, Marvin and Obraczka, Daniel and Saeedi, Alieh and K{\"o}pcke, Hanna and Rahm, Erhard},
  year = 2024,
  month = aug,
  abstract = {Der Beitrag bietet eine systematische und umfassende \"Ubersicht zum aktuellen Stand der Knowledge-Graph-Konstruktion mit besonderem Fokus auf inkrementelle Aktualisierungspipelines. W\"ahrend viele Einzelschritte -- etwa Information Extraction, Entity Resolution oder Ontologieintegration -- bereits intensiv erforscht wurden, fehlt bislang eine ganzheitliche Betrachtung ihrer Verzahnung in skalierbaren, kontinuierlich aktualisierbaren KG-Pipelines. Die Autor:innen strukturieren den KG-Konstruktionsprozess entlang mehrerer Dimensionen: - Graphmodelle (RDF vs. Property Graph Model) - Anwendungsdom\"anen (allgemeine vs. dom\"anenspezifische KGs) - Anforderungen an inkrementelle Konstruktion - Zentrale Pipeline-Aufgaben, darunter: - Metadatenmanagement . Datenakquisition und -transformation - Ontologieentwicklung - Knowledge Extraction (NER, Relation Extraction) - Entity Resolution und Fusion - Knowledge Completion - Qualit\"atssicherung Ein zentrales Argument ist, dass traditionelle batch-orientierte Konstruktion f\"ur dynamische Anwendungsfelder nicht ausreicht. Stattdessen werden inkrementelle, skalierbare und modularisierte Pipelines gefordert, die neue Datenquellen effizient integrieren k\"onnen, ohne vollst\"andige Neukonstruktion des Graphen. Dabei spielen Metadaten, Versionierung (Snapshot-, Delta- und zeitbasierte Modelle), Provenienz sowie Pipeline-Orchestrierung eine Schl\"usselrolle. Die Autor:innen formulieren vier \"ubergreifende Anforderungsgruppen: - Input- und Heterogenit\"atsbew\"altigung - Inkrementelle Aktualisierbarkeit - Pipeline- und Tool-Interoperabilit\"at - Qualit\"atssicherung entlang mehrerer Dimensionen (Korrektheit, Vollst\"andigkeit, Frische, Konsistenz, Vertrauensw\"urdigkeit) Dar\"uber hinaus werden bestehende Systeme und 27 konkrete KG-Konstruktionsans\"atze vergleichend evaluiert. Abschlie\ss end identifiziert der Beitrag offene Forschungsfelder, insbesondere: - durchg\"angige Unterst\"utzung inkrementeller Updates - bessere Interoperabilit\"at zwischen RDF und Property Graphs - st\"arkere Integration von ML- und LLM-basierten Verfahren - systematische Qualit\"atsmetriken - Automatisierung bei Ontologie- und Mapping-Generierung Der Artikel positioniert sich damit als Referenzrahmen f\"ur zuk\"unftige KG-Konstruktionsarchitekturen und liefert sowohl konzeptionelle Leitlinien als auch praktische Evaluationskriterien f\"ur robuste, nachhaltige Knowledge-Graph-Infrastrukturen.}
}

@misc{zotero-item-6765,
  title = {The {{Artificial Intelligence Ontology}}: {{LLM-Assisted Construction}} of {{AI Concept Hierarchies}}},
  author = {Joachimiak, Marcin P. and Miller, Mark A. and Caufield, J. Harry and Ly, Ryan and Harris, Nomi L. and Tritt, Andrew and Mungall, Christopher J. and Bouchard, Kristofer E.},
  year = 2024,
  abstract = {Der Beitrag stellt die Artificial Intelligence Ontology (AIO) vor, eine systematische Ontologie zur Strukturierung zentraler Konzepte, Methoden und Relationen im Bereich K\"unstliche Intelligenz (KI). Ziel ist die Standardisierung technischer, methodischer und ethischer Begriffe in einem Forschungsfeld, das durch rasante Entwicklungen gepr\"agt ist. Die AIO umfasst acht Hauptzweige (,,branches``): Bias, Layer, Machine Learning Task, Mathematical Function, Model, Network, Preprocessing und Training Strategy. Diese modular aufgebaute Struktur erlaubt die formale Repr\"asentation von KI-Methoden anhand ihrer konstitutiven Bausteine (z. B. Layer-Typen, mathematische Funktionen, Trainingsstrategien) und integriert zugleich ethische Dimensionen wie Bias-Kategorien. Insgesamt enth\"alt die Ontologie 442 Klassen, 439 Synonyme und 513 Subclass-Relationen (vgl. Tab. 2, S. 413). Die Ontologie wurde mit dem Ontology Development Kit (ODK) entwickelt und verwendet den ELK-Reasoner im OWL-EL-Profil f\"ur effiziente Validierung. Ein zentrales methodisches Merkmal ist die LLM-gest\"utzte Ontologieentwicklung: Large Language Models (GPT-4, Claude 3) wurden zur Generierung, Erweiterung und Revision von Klassen, Definitionen und Substrukturen eingesetzt, insbesondere f\"ur die Zweige ,,Language Model``, ,,Preprocessing`` und ,,Training Strategy``. Definitionen wurden in einem zweistufigen Verfahren mithilfe ontologischer Leitlinien (Sepp\"al\"a et al.) sowie aristotelischer Definitionstechniken verfeinert. Zur Evaluation wurden mehrere Verfahren kombiniert: - Formale Validierung \"uber ODK, ELK und ROBOT - Inter-Ontologie-Mappings (u. a. CSO, EDAM, ITO, MLO, NCIT, SWO) - NLP-basierte Annotation des Papers with Code Methods Corpus (2194 Publikationen) - Integration in BioPortal - Anwendung der MIRO-Guidelines Die NLP-Analyse ergab 7.582 AIO-Annotationen im Papers-with-Code-Korpus, wobei nahezu die H\"alfte aller AIO-Klassen lexikalisch nachweisbar war. Dies belegt eine hohe Abdeckung aktueller KI-Terminologie. Der Beitrag zeigt, dass eine LLM-unterst\"utzte Ontologieentwicklung nicht nur die Skalierbarkeit und Aktualisierbarkeit verbessert, sondern auch neue Formen der kollaborativen, semi-automatischen Wissensmodellierung erm\"oglicht. Die AIO positioniert sich damit als nachhaltige Referenzstruktur f\"ur KI-Konzepte, die sowohl technische als auch ethische Dimensionen integriert und als interoperable Grundlage f\"ur Forschungsinfrastrukturen, Modellkataloge (z. B. Papers with Code, Hugging Face) sowie Knowledge-Graph-Anwendungen dienen kann.}
}

@misc{zotero-item-6766,
  title = {Editorial: {{Special Issue}} on {{Ontologies}} and {{Large-Language Models}}},
  author = {Beverley, John},
  abstract = {Das Editorial f\"uhrt in das erste von zwei B\"anden des Special Issue ,,Ontologies and Large-Language Models`` der Zeitschrift Applied Ontology ein. Es rahmt die aktuelle Forschung an der Schnittstelle von Wissensrepr\"asentation und generativer KI als einen historischen Moment der Konvergenz symbolischer und statistischer Ans\"atze. W\"ahrend Large Language Models (LLMs) durch ihre generative Leistungsf\"ahigkeit beeindrucken, bestehen weiterhin Herausforderungen wie Halluzinationen, Bias, mangelnde Dom\"anentiefe und Black-Box-Charakter. Ontologien, Knowledge Graphs und semantische Technologien werden als zentrale Instrumente hervorgehoben, um diese Schw\"achen systematisch zu adressieren. Das Special Issue verfolgt das Ziel, Beitr\"age zu versammeln, die entweder Ontologie-Engineering durch LLMs bereichern oder umgekehrt LLMs durch ontologische Strukturen verbessern. Genannt werden Themen wie automatisierte Ontologieentwicklung, LLM-gest\"utzte Knowledge-Graph-Konstruktion, Qualit\"atskontrolle, Benchmarking sowie hybride Architekturen (z. B. Retrieval-Augmented Generation mit Wissensgraphen). Der erste Band umfasst f\"unf ausgew\"ahlte Beitr\"age aus 15 Einreichungen, darunter vier Forschungsartikel und ein Ontologiebericht. Die behandelten Themen reichen von der automatisierten Klassifikation von Dom\"anenentit\"aten in Top-Level-Ontologien \"uber kollaborative Human--LLM-Ontologieentwicklung bis hin zu ontologiebasierter Validierung maschinengenerierter Inhalte und LLM-unterst\"utzter Ontologiekonstruktion im Bereich K\"unstliche Intelligenz. Das Editorial argumentiert, dass die Kombination der generativen St\"arke von LLMs mit der strukturellen Pr\"azision ontologischer Modellierung neue M\"oglichkeiten f\"ur robuste, nachvollziehbare und zweckgerichtete KI-Systeme er\"offnet. Der Band wird als Impuls f\"ur eine engere Verzahnung der Forschungscommunities von Knowledge Engineering und Large-Language-Model-Forschung positioniert.}
}

